{
  "name": "@workspace/web",
  "version": "1.2.0",
  "private": true,
  "description": "Personal portfolio for Tri Rizeki Rifandani — work experience, projects, and writing.",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "scripts": {
    "pwa-assets:gen": "pwa-assets-generator",
    "typecheck": "next typegen && tsc --noEmit",
    "typerange": "next typegen && fr",
    "typerange:audit": "next typegen && fr --audit",
    "bump:nextjs": "bunx @next/codemod@canary upgrade latest",
    "test:install": "playwright install --with-deps chromium",
    "test:report": "playwright show-report",
    "test": "playwright test",
    "test:ui": "DEBUG=pw:api playwright test --ui",
    "test:ci": "playwright test --forbid-only",
    "test:unit": "vitest run --project web",
    "check-site-meta": "bunx check-site-meta 3002 -p 3052",
    "analyze-bundle-size": "next experimental-analyze",
    "dev": "portless run --name web.portfolio next dev",
    "build": "next build",
    "build:standalone": "BUILD_STANDALONE=1 next build",
    "start": "next start",
    "zap:serve": "next start --port 4100 --hostname 0.0.0.0",
    "start:standalone": "node .next/standalone/apps/web/server.js",
    "build-and-preview": "bun run build && bun run start"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@nosecone/next": "1.13.0",
    "@reactuses/core": "6.5.9",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/highlight": "1.0.0",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-form-nextjs": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "cn": "0.4.0",
    "embla-carousel-react": "8.6.0",
    "evlog": "2.29.0",
    "input-otp": "1.5.0",
    "ky": "2.1.0",
    "motion": "13.5.0",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "radashi": "12.9.6",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-stately": "3.50.0",
    "recharts": "3.10.1",
    "schema-dts": "2.0.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-variants": "3.3.1",
    "ts-pattern": "5.9.0",
    "tw-animate-css": "1.4.0",
    "type-fest": "5.10.0",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.104.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@workspace/typescript-config": "workspace:*",
    "agentation": "3.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "7.0.2"
  }
}
